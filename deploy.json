{
  "schema_version": 2,
  "project": "codex-chinese",
  "version": "v2.0.7",
  "repository": "https://github.com/zhenglei410/codex-chinese",
  "primary_platform": "windows",
  "agent_entrypoint": "AGENTS.md",
  "human_guide": "docs/AI_DEPLOY.md",
  "architecture": "docs/ARCHITECTURE.md",
  "troubleshooting": "docs/TROUBLESHOOTING.md",
  "requirements": {
    "go": ">=1.21",
    "node": ">=18 optional but required before release",
    "git": "required to clone"
  },
  "commands": {
    "windows_build_install": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\ai_deploy.ps1 -Version v2.0.7",
    "windows_manual_install": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\install_windows.ps1 -Version v2.0.7 -AssetDir .\\dist -Mode tray",
    "verify": "& \"$env:LOCALAPPDATA\\Programs\\codex-chinese\\codex-chinese.exe\" -verify",
    "diagnose": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\diagnose_windows.ps1"
  },
  "artifacts": [
    "dist/codex-chinese-windows-amd64.exe",
    "dist/codex-chinese-windows-arm64.exe",
    "dist/codex-chinese-darwin-amd64",
    "dist/codex-chinese-darwin-arm64",
    "dist/codex-chinese-linux-amd64",
    "dist/codex-chinese-linux-arm64",
    "dist/codex-chinese-tray-windows-amd64.exe",
    "dist/codex-chinese-tray-windows-arm64.exe",
    "dist/codex-chinese.ico"
  ],
  "install_paths": {
    "cli": "%LOCALAPPDATA%\\Programs\\codex-chinese\\codex-chinese.exe",
    "tray": "%LOCALAPPDATA%\\Programs\\codex-chinese\\codex-chinese-tray.exe",
    "icon": "%LOCALAPPDATA%\\Programs\\codex-chinese\\codex-chinese.ico",
    "desktop_shortcut": "%USERPROFILE%\\Desktop\\Codex 中文.lnk",
    "autostart_registry": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
    "autostart_value": "CodexChinese"
  },
  "success": {
    "exit_code": 0,
    "stdout_contains": [
      "verify: installed=true lang=zh-CN i18n=true",
      "PASS"
    ],
    "also_require": [
      "8 artifacts",
      "go vet exit 0",
      "prelude test ALL PASS when Node is installed",
      "tray subsystem 2",
      "desktop shortcut targets codex-chinese-tray.exe",
      "shortcut icon targets codex-chinese.ico"
    ]
  },
  "runtime": {
    "mode": "persistent-supervisor",
    "default_port_range": "9229-9258",
    "guard_process": "Windows tray",
    "autostart": true,
    "force_reload_on_start": false
  },
  "forbidden": [
    "create .bat or .vbs launchers",
    "write a fixed WindowsApps version path",
    "traverse WindowsApps to find Codex",
    "run multiple supervisors on different ports",
    "force Page.reload during Codex bootstrap",
    "claim success without -verify exit code 0"
  ]
}
